POI_CURATOR_ENV=local
POI_CURATOR_API_HOST=0.0.0.0
POI_CURATOR_API_PORT=8000
POI_CURATOR_DATABASE_URL=postgresql+psycopg://poi_curator:poi_curator@localhost:5432/poi_curator
# Required for /v1/admin endpoints. Replace with a local secret.
POI_CURATOR_ADMIN_KEY=replace-me
POI_CURATOR_ALLOW_FIXTURE_FALLBACK=true
# Optional QA/debug table writes for suggestion requests and score breakdowns.
POI_CURATOR_QUERY_LOGGING=false
POI_CURATOR_DEFAULT_REGION=santa-fe
POI_CURATOR_SCORING_PROFILE_VERSION=v0
POI_CURATOR_OVERPASS_URL=https://overpass-api.de/api/interpreter
POI_CURATOR_OVERPASS_TIMEOUT_SECONDS=60
